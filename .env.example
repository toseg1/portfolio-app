# =====================================================================
# Copy this file to `.env` and fill in the values.
#
#   cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed.
#
# ⚠️  NEVER put production credentials in your local .env.
#     A laptop pointed at production will consume real users' tasks,
#     render their reports on your machine, and run migrations against
#     live financial records. Guard 2 below is there to stop you.
# =====================================================================

# --- Environment -----------------------------------------------------
# local | production
ENVIRONMENT=local
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string

# --- Safety guards (ADR-028) -----------------------------------------
# Guard 1: Celery Beat refuses to start unless this is exactly "true".
#          Set true ONLY on the Render worker service. Never locally.
ENABLE_BEAT=false

# Guard 2: with ENVIRONMENT=local, the app refuses to boot if
#          DATABASE_URL points anywhere other than a local host.

# --- Database --------------------------------------------------------
# Local: the Docker Compose service is named `postgres`.
DATABASE_URL=postgresql://portfolio:portfolio@postgres:5432/portfolio

# --- Redis (cache + Celery broker) -----------------------------------
# Separate logical databases so a cache flush never eats the task queue.
REDIS_CACHE_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- Domains and cookies (ADR-011) -----------------------------------
# SameSite=Lax requires frontend and API to be SAME-SITE.
# Production: apex for Next.js, api. subdomain for Django,
#             cookie domain at the registrable domain.
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
SESSION_COOKIE_DOMAIN=localhost
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Object storage, EU (ADR-015) ------------------------------------
# Cloudflare R2 or Scaleway. Private buckets, pre-signed URLs only.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=

# --- Backups (08) ----------------------------------------------------
# Dumps are encrypted BEFORE upload. The provider never holds plaintext.
BACKUP_ENCRYPTION_KEY=

# --- Stripe (ADR-020, ADR-021) ---------------------------------------
# Use test keys locally. Price IDs live on Plan rows, never in code.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Market data (ADR-018) -------------------------------------------
# Business logic never imports these directly — only adapters do.
MARKET_DATA_PROVIDER=yfinance
LICENSED_FEED_API_KEY=

# Stops stockdex initialising Jupyter integration outside Jupyter (11).
JUPYTER_PLATFORM_DIRS=1

# --- Email — transport (ADR-029) --------------------------------------
# Local: the Docker Compose service is named `mailpit`. Nothing sent here
# is ever real — web inbox at http://localhost:8025.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false

# --- Email — sender identity (ADR-029, 15 — Email & Notifications) ---
# Templates never name an address, only a role — configuration maps roles
# to addresses. Guard 4 refuses to boot if any EMAIL_FROM_* address below
# doesn't belong to EMAIL_DOMAIN.
EMAIL_DOMAIN=example.invalid
EMAIL_FROM_SYSTEM="Portfolio App <hello@example.invalid>"
EMAIL_FROM_ADVISORY="Théo Seguin <theo.seguin@example.invalid>"
EMAIL_REPLY_TO=hello@example.invalid
EMAIL_OPERATOR_ALERTS=theo.seguin@example.invalid

# --- Frontend (Next.js) ----------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=fr-FR
